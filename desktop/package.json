{
  "name": "tacosv2-desktop",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "worker:build": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Set-Location ..; .\\.venv\\Scripts\\python.exe -m PyInstaller --noconfirm --clean --hidden-import uuid --name tacos-engine --distpath desktop\\engine-dist --workpath build\\engine-pyinstaller --specpath build\\engine-pyinstaller desktop\\engine\\worker.py\"",
    "worker:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-packaged-worker.ps1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run worker:build && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "lucide-react": "^0.565.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  }
}
